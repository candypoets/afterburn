@@ -0,0 +1,343 @@
+//! The New page dialog: a name, a first prompt, and the agent that will design it.
+//!
+//! `page.add` selects the new page; if a prompt is given it is sent once to the composer's chosen
+//! agent with the service's `send` method. The page exists even if the prompt later fails, so a
+//! retry never creates a second page.
+
+use std::sync::mpsc::{self, Receiver};
+
+use egui::{Align2, Color32, CornerRadius, Id, Margin, RichText, Stroke, vec2};
+use serde_json::json;
+
+use crate::FigApp;
+use crate::compose::{SendReply, send_request};
+use crate::theme::{regular, semibold};
+use crate::workspaces;
+
+/// The node metadata key that points a component at its detail page.
+pub const DETAIL_PAGE_KEY: &str = "mindmap.detail_page";
+
+const PANEL: Color32 = Color32::WHITE;
+const BORDER: Color32 = Color32::from_rgb(0xE3, 0xE2, 0xDF);
+const INK: Color32 = Color32::from_rgb(0x1A, 0x1A, 0x1A);
+const MUTED: Color32 = Color32::from_rgb(0x6E, 0x6C, 0x68);
+const FAINT: Color32 = Color32::from_rgb(0x9A, 0x97, 0x91);
+const ACCENT: Color32 = Color32::from_rgb(0xB5, 0x45, 0x2F);
+
+/// The component a new page is generated from.
+#[derive(Clone, Debug)]
+pub struct Source {
+    pub page_id: u64,
+    pub page_name: String,
+    pub node_id: u64,
+    pub node_name: String,
+}
+
+/// The dialog's state.
+#[derive(Default)]
+pub struct State {
+    pub open: bool,
+    name: String,
+    prompt: String,
+    busy: bool,
+    /// The page was created; a retry only sends the prompt again.
+    created: bool,
+    error: Option<String>,
+    rx: Option<Receiver<Result<SendReply, String>>>,
+    page_id: Option<u64>,
+    source: Option<Source>,
+    /// The source component was linked to the new page.
+    link_set: bool,
+    focus: bool,
+}
+
+impl State {
+    /// Open with a suggested name.
+    pub fn start(&mut self, number: usize) {
+        self.open = true;
+        self.name = format!("Page {number}");
+        self.prompt.clear();
+        self.busy = false;
+        self.created = false;
+        self.error = None;
+        self.rx = None;
+        self.page_id = None;
+        self.source = None;
+        self.link_set = false;
+        self.focus = true;
+    }
+
+    /// Start a new page from a component: inferred title and prompt, editable, with its source.
+    pub fn start_component(&mut self, number: usize, source: Source) {
+        self.start(number);
+        self.name = format!("{} — detail", source.node_name);
+        self.prompt = format!(
+            "Explain in detail what is inside the \"{}\" component on the \"{}\" page: its purpose, \n\
+             the parts it is made of, how they connect, and the code that implements it. \n\
+             Draw this new page with sourced cards.",
+            source.node_name, source.page_name
+        );
+        self.source = Some(source);
+    }
+}
+
+/// Draw the dialog (map mode). It owns its own send thread so the composer is untouched.
+pub fn show(app: &mut FigApp, ctx: &egui::Context) {
+    poll(app);
+    if !app.new_page.open {
+        return;
+    }
+    let targets = app.compose.targets.clone();
+    let mut selected = app.compose.target.clone();
+    let mut close = false;
+    let mut create = false;
+    let busy = app.new_page.busy;
+    let created = app.new_page.created;
+
+    egui::Area::new(Id::new("new_page_modal"))
+        .anchor(Align2::CENTER_CENTER, vec2(0.0, -20.0))
+        .order(egui::Order::Foreground)
+        .show(ctx, |ui| {
+            egui::Frame::NONE
+                .fill(PANEL)
+                .stroke(Stroke::new(1.0, BORDER))
+                .corner_radius(CornerRadius::same(10))
+                .shadow(egui::epaint::Shadow { offset: [0, 10], blur: 30, spread: 0, color: Color32::from_black_alpha(46) })
+                .inner_margin(Margin::symmetric(20, 16))
+                .show(ui, |ui| {
+                    ui.set_width(420.0);
+                    ui.horizontal(|ui| {
+                        ui.label(RichText::new("NEW PAGE").font(egui::FontId::monospace(9.5)).color(ACCENT));
+                        ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                            if ui.add(egui::Button::new(RichText::new("×").size(16.0).color(MUTED)).frame(false)).clicked() {
+                                close = true;
+                            }
+                        });
+                    });
+                    if let Some(source) = app.new_page.source.as_ref() {
+                        ui.add_space(6.0);
+                        ui.label(
+                            RichText::new(format!("From component · {} · {}", source.node_name, source.page_name))
+                                .font(egui::FontId::monospace(8.8))
+                                .color(ACCENT),
+                        );
+                    }
+                    ui.add_space(10.0);
+                    ui.label(RichText::new("Name").font(semibold(11.0)).color(INK));
+                    ui.add_space(4.0);
+                    let name = ui.add_enabled(
+                        !created && !busy,
+                        egui::TextEdit::singleline(&mut app.new_page.name)
+                            .font(regular(13.0))
+                            .desired_width(f32::INFINITY)
+                            .hint_text("Page name"),
+                    );
+                    if app.new_page.focus {
+                        name.request_focus();
+                        app.new_page.focus = false;
+                    }
+                    ui.add_space(12.0);
+                    ui.label(RichText::new("First prompt").font(semibold(11.0)).color(INK));
+                    ui.add_space(4.0);
+                    ui.add(
+                        egui::TextEdit::multiline(&mut app.new_page.prompt)
+                            .font(regular(12.5))
+                            .desired_rows(4)
+                            .desired_width(f32::INFINITY)
+                            .hint_text("What should this page become?"),
+                    );
+                    ui.add_space(12.0);
+                    ui.label(RichText::new("Agent").font(semibold(11.0)).color(INK));
+                    ui.add_space(4.0);
+                    if targets.is_empty() {
+                        ui.label(RichText::new("No agent list yet; choose one in the composer.").font(regular(11.0)).color(MUTED));
+                    } else {
+                        let current = selected
+                            .as_ref()
+                            .map(|target| kind_label(target.kind()).to_string())
+                            .unwrap_or_else(|| "Choose an agent".to_string());
+                        egui::ComboBox::from_id_salt("new_page_agent")
+                            .selected_text(RichText::new(current).font(regular(12.0)).color(INK))
+                            .width(260.0)
+                            .show_ui(ui, |ui| {
+                                for info in &targets {
+                                    let label = if info.new_agent {
+                                        format!("start {}", kind_label(info.target.kind()))
+                                    } else if info.status.trim().is_empty() {
+                                        kind_label(info.target.kind()).to_string()
+                                    } else {
+                                        format!("{} · {}", kind_label(info.target.kind()), info.status)
+                                    };
+                                    if ui.selectable_label(selected.as_ref() == Some(&info.target), label).clicked() {
+                                        selected = Some(info.target.clone());
+                                    }
+                                }
+                            });
+                    }
+                    if let Some(error) = app.new_page.error.clone() {
+                        ui.add_space(10.0);
+                        ui.label(RichText::new(error).font(regular(11.0)).color(ACCENT));
+                    }
+                    ui.add_space(16.0);
+                    ui.horizontal(|ui| {
+                        let prompt_missing = app.new_page.prompt.trim().is_empty();
+                        let can_create = !app.new_page.name.trim().is_empty()
+                            && !app.new_page.name.trim().starts_with('-')
+                            && (prompt_missing || selected.is_some())
+                            && !busy;
+                        let label = if busy {
+                            "Sending…"
+                        } else if created {
+                            "Send prompt"
+                        } else if prompt_missing {
+                            "Create page"
+                        } else {
+                            "Create and prompt"
+                        };
+                        let button = egui::Button::new(RichText::new(label).font(semibold(11.5)).color(Color32::WHITE))
+                            .fill(if can_create { ACCENT } else { Color32::from_rgb(0xC9, 0xB7, 0xB2) })
+                            .corner_radius(CornerRadius::same(6))
+                            .min_size(vec2(150.0, 34.0));
+                        if ui.add_enabled(can_create, button).clicked() {
+                            create = true;
+                        }
+                        ui.add_space(8.0);
+                        if ui.add_enabled(!busy, egui::Button::new(RichText::new("Cancel").font(regular(11.5)).color(MUTED)).frame(false)).clicked() {
+                            close = true;
+                        }
+                        ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                            ui.label(RichText::new("The page is blank until the agent draws.").font(egui::FontId::monospace(8.5)).color(FAINT));
+                        });
+                    });
+                });
+        });
+
+    if selected != app.compose.target {
+        app.compose.target = selected;
+    }
+    if close && !busy {
+        app.new_page.open = false;
+    }
+    if create {
+        submit(app, ctx);
+    }
+    if ctx.input(|i| i.key_pressed(egui::Key::Escape)) && !busy {
+        app.new_page.open = false;
+    }
+}
+
+fn submit(app: &mut FigApp, ctx: &egui::Context) {
+    let name = app.new_page.name.trim().to_string();
+    if name.is_empty() || name.starts_with('-') {
+        app.new_page.error = Some("Name the page; a leading '-' would make it a divider.".to_string());
+        return;
+    }
+    if !app.new_page.created {
+        let Some(created) = app.run("page.add", json!({"name": name})) else {
+            app.new_page.error = Some(app.ui.last_error.take().unwrap_or_else(|| "The page could not be created.".to_string()));
+            return;
+        };
+        app.new_page.page_id = created.get("id").and_then(serde_json::Value::as_u64);
+        app.new_page.created = true;
+    }
+    if !app.new_page.link_set
+        && let (Some(source), Some(page_id)) = (app.new_page.source.clone(), app.new_page.page_id)
+    {
+        let params = json!({
+            "id": source.node_id,
+            "pluginData": { DETAIL_PAGE_KEY: page_id.to_string() },
+        });
+        if let Err(error) = app.session.execute("node.set", &params) {
+            app.new_page.error = Some(format!("The page was created, but the component link failed: {error}"));
+            return;
+        }
+        app.new_page.link_set = true;
+    }
+    let prompt = app.new_page.prompt.trim().to_string();
+    if prompt.is_empty() {
+        app.new_page.open = false;
+        app.toast(format!("Created {name}"));
+        return;
+    }
+    let Some(workspace) = app.active_workspace.clone() else {
+        app.new_page.error = Some("Open a workspace map before prompting an agent.".to_string());
+        return;
+    };
+    let Some(target) = app.compose.target.clone() else {
+        app.new_page.error = Some("Choose an agent for the first prompt.".to_string());
+        return;
+    };
+    let text = prompt;
+    let request = json!({
+        "id": 1,
+        "method": "send",
+        "workspace": workspace,
+        "target": target.line(),
+        "prompt": text,
+        "comments": [],
+        "page_id": app.new_page.page_id,
+        "new_page": true,
+        "source_page_id": app.new_page.source.as_ref().map(|source| source.page_id),
+        "source_node_id": app.new_page.source.as_ref().map(|source| source.node_id),
+    })
+    .to_string();
+    let (tx, rx) = mpsc::channel();
+    app.new_page.busy = true;
+    app.new_page.error = None;
+    app.new_page.rx = Some(rx);
+    let address = workspaces::service_addr();
+    let context = ctx.clone();
+    let spawned = std::thread::Builder::new().name("figcraft-new-page-prompt".into()).spawn(move || {
+        let reply = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| send_request(&address, &request)))
+            .unwrap_or_else(|_| Err("The first prompt failed unexpectedly.".to_string()));
+        let _ = tx.send(reply);
+        context.request_repaint();
+    });
+    if let Err(error) = spawned {
+        app.new_page.busy = false;
+        app.new_page.rx = None;
+        app.new_page.error = Some(format!("Could not send the first prompt: {error}"));
+    }
+}
+
+fn poll(app: &mut FigApp) {
+    let received = app.new_page.rx.as_ref().map(Receiver::try_recv);
+    let received = match received {
+        None => return,
+        Some(Ok(reply)) => reply,
+        Some(Err(mpsc::TryRecvError::Empty)) => return,
+        Some(Err(mpsc::TryRecvError::Disconnected)) => {
+            app.new_page.rx = None;
+            app.new_page.busy = false;
+            app.new_page.error = Some("The first prompt ended without an answer.".to_string());
+            return;
+        }
+    };
+    app.new_page.rx = None;
+    app.new_page.busy = false;
+    match received {
+        Ok(reply) if reply.ok => {
+            app.new_page.open = false;
+            let agent = reply
+                .agent
+                .as_ref()
+                .and_then(|agent| agent.get("kind").and_then(serde_json::Value::as_str))
+                .unwrap_or("the agent");
+            app.toast(format!("Created {}; prompt sent to {agent}", app.new_page.name.trim()));
+        }
+        Ok(reply) => {
+            app.new_page.error = Some(reply.error.unwrap_or_else(|| "The prompt was refused.".to_string()));
+        }
+        Err(error) => app.new_page.error = Some(error),
+    }
+}
+
+fn kind_label(kind: &str) -> &str {
+    match kind {
+        "codex" => "codex",
+        "claude" => "claude",
+        "kimi" => "kimi",
+        "dsh" | "dsh-tui" => "dsh",
+        other => other,
+    }
+}
diff -ruN --exclude target .client-src-orig/crates/ui-egui/src/page_delete.rs client-src/crates/ui-egui/src/page_delete.rs
--- .client-src-orig/crates/ui-egui/src/page_delete.rs	1970-01-01 01:00:00.000000000 +0100
+++ client-src/crates/ui-egui/src/page_delete.rs	2026-10-22 15:43:19.847020317 +0200
@@ -0,0 +1,73 @@
+//! Delete-page confirmation. A page's cards and comments are not recoverable from the map UI.
+
+use egui::{Align2, Color32, CornerRadius, FontId, Id, Margin, RichText, Stroke, vec2};
+
+use crate::FigApp;
+use crate::theme::{regular, semibold};
+
+const PANEL: Color32 = Color32::WHITE;
+const BORDER: Color32 = Color32::from_rgb(0xE3, 0xE2, 0xDF);
+const TEXT: Color32 = Color32::from_rgb(0x1A, 0x1A, 0x1A);
+const MUTED: Color32 = Color32::from_rgb(0x6E, 0x6C, 0x68);
+const DANGER: Color32 = Color32::from_rgb(0x9E, 0x3B, 0x2C);
+
+/// Draw the confirmation when a page deletion is pending.
+pub fn show(app: &mut FigApp, ctx: &egui::Context) {
+    let Some(id) = app.page_delete else { return };
+    let name = app
+        .session
+        .doc()
+        .ok()
+        .and_then(|doc| doc.node(id))
+        .map(|node| node.name.clone())
+        .unwrap_or_else(|| "this page".to_string());
+    let mut cancel = false;
+    let mut delete = false;
+    egui::Area::new(Id::new("page_delete_modal"))
+        .anchor(Align2::CENTER_CENTER, vec2(0.0, -20.0))
+        .order(egui::Order::Foreground)
+        .show(ctx, |ui| {
+            egui::Frame::NONE
+                .fill(PANEL)
+                .stroke(Stroke::new(1.0, BORDER))
+                .corner_radius(CornerRadius::same(10))
+                .shadow(egui::epaint::Shadow { offset: [0, 10], blur: 30, spread: 0, color: Color32::from_black_alpha(46) })
+                .inner_margin(Margin::symmetric(20, 16))
+                .show(ui, |ui| {
+                    ui.set_width(380.0);
+                    ui.label(RichText::new("DELETE PAGE").font(FontId::monospace(9.5)).color(DANGER));
+                    ui.add_space(8.0);
+                    ui.label(RichText::new(format!("Delete “{name}”?")).font(semibold(17.0)).color(TEXT));
+                    ui.add_space(5.0);
+                    ui.label(
+                        RichText::new("Its cards and comments are removed from the live map. This cannot be undone from the app.")
+                            .font(regular(11.5))
+                            .color(MUTED),
+                    );
+                    ui.add_space(16.0);
+                    ui.horizontal(|ui| {
+                        if ui.add(egui::Button::new(RichText::new("Cancel").font(regular(11.5)).color(MUTED)).frame(false)).clicked() {
+                            cancel = true;
+                        }
+                        ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                            let button = egui::Button::new(RichText::new("Delete page").font(semibold(11.5)).color(Color32::WHITE))
+                                .fill(DANGER)
+                                .corner_radius(CornerRadius::same(6))
+                                .min_size(vec2(110.0, 32.0));
+                            if ui.add(button).clicked() {
+                                delete = true;
+                            }
+                        });
+                    });
+                });
+        });
+    if delete {
+        let page_name = name.clone();
+        if app.run("page.delete", serde_json::json!({"id": id})).is_some() {
+            app.toast(format!("Deleted {page_name}"));
+        }
+        app.page_delete = None;
+    } else if cancel || ctx.input(|input| input.key_pressed(egui::Key::Escape)) {
+        app.page_delete = None;
+    }
+}
diff -ruN --exclude target .client-src-orig/crates/ui-egui/src/sync.rs client-src/crates/ui-egui/src/sync.rs
--- .client-src-orig/crates/ui-egui/src/sync.rs	1970-01-01 01:00:00.000000000 +0100
+++ client-src/crates/ui-egui/src/sync.rs	2026-10-22 13:47:35.080999864 +0200
@@ -0,0 +1,1563 @@
+//! Sync: the map's drift from the last sync, the code drift since it, and one action.
+//!
+//! The button is a floating pill at the map's top right, never a mode: it opens a widget with the
+//! design changes the agent is about to implement, the code that changed since the last sync, an
+//! agent target and an optional note. A sync runs on the project service; while it is in flight the
+//! widget (and the button, when the widget is closed) shows the flight, the map stays editable, and
+//! a thread polls `sync_status` once a second until the service reports `done` or `failed`.
+//!
+//! Every request is newline JSON over plain TCP on a named thread of its own. The snapshot is built
+//! from the open document each time a diff or sync is asked for, so the widget never talks about a
+//! map the human is no longer looking at.
+
+use std::collections::HashSet;
+use std::sync::mpsc::{self, Receiver};
+
+use egui::{Align2, Color32, CornerRadius, FontId, Id, Key, Rect, Sense, Stroke, StrokeKind, Ui, pos2, vec2};
+use figcraft_doc::{Document, NodeId, NodeKind};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+
+use crate::FigApp;
+use crate::a11y;
+use crate::compose::TargetInfo;
+use crate::theme::{regular, semibold};
+use crate::widgets;
+use crate::workspaces::{self, Target};
+
+#[cfg(not(target_arch = "wasm32"))]
+use std::io::{BufRead, BufReader, Read, Write};
+#[cfg(not(target_arch = "wasm32"))]
+use std::net::{TcpStream, ToSocketAddrs};
+#[cfg(not(target_arch = "wasm32"))]
+use std::time::Duration;
+
+/// The most pages one snapshot may carry (the service rejects more).
+const MAX_PAGES: usize = 500;
+/// The most nodes one snapshot may carry (the service rejects more).
+const MAX_NODES: usize = 5_000;
+/// The note is kept well under the service's prompt limit.
+const MAX_NOTE_CHARS: usize = 2_000;
+/// The widget's width.
+const WIDGET_W: f32 = 380.0;
+/// The widget's inner padding.
+const PAD: f32 = 18.0;
+/// The top button's height and its distance from the window's edge.
+const BUTTON_H: f32 = 32.0;
+const EDGE: f32 = 18.0;
+/// How many names, files and commits each list shows before `+N more`.
+const NAMES: usize = 4;
+const FILES: usize = 4;
+const COMMITS: usize = 3;
+
+/// The warm map palette, shared with the composer and the map bar.
+const PANEL: Color32 = Color32::WHITE;
+const SOFT: Color32 = Color32::from_rgb(0xF8, 0xF6, 0xF3);
+const BORDER: Color32 = Color32::from_rgb(0xE3, 0xE2, 0xDF);
+const INK: Color32 = Color32::from_rgb(0x1A, 0x1A, 0x1A);
+const MUTED: Color32 = Color32::from_rgb(0x6E, 0x6C, 0x68);
+const FAINT: Color32 = Color32::from_rgb(0x9A, 0x97, 0x91);
+const ACCENT: Color32 = Color32::from_rgb(0xB5, 0x45, 0x2F);
+const ACCENT_HOVER: Color32 = Color32::from_rgb(0xC2, 0x55, 0x3E);
+const MAP_INK: Color32 = Color32::from_rgb(0x2F, 0x6F, 0x6A);
+const DANGER: Color32 = Color32::from_rgb(0x9E, 0x3B, 0x2C);
+
+#[cfg(not(target_arch = "wasm32"))]
+const CONNECT_TIMEOUT: Duration = Duration::from_secs(5);
+/// A diff runs `git` on the project host and may read a large repository.
+#[cfg(not(target_arch = "wasm32"))]
+const DIFF_TIMEOUT: Duration = Duration::from_secs(30);
+/// Starting a sync may have to start an agent and accept a first-run prompt.
+#[cfg(not(target_arch = "wasm32"))]
+const SYNC_TIMEOUT: Duration = Duration::from_secs(120);
+/// One status poll asks Herdr; it is quick, but the host may be busy.
+#[cfg(not(target_arch = "wasm32"))]
+const STATUS_TIMEOUT: Duration = Duration::from_secs(15);
+/// A reply larger than this is refused rather than read into memory.
+#[cfg(not(target_arch = "wasm32"))]
+const MAX_REPLY: usize = 1024 * 1024;
+/// How often the status thread asks while a job is in flight.
+#[cfg(not(target_arch = "wasm32"))]
+const POLL_EVERY: Duration = Duration::from_secs(1);
+/// The service times a job out after 30 minutes; stop polling shortly after.
+#[cfg(not(target_arch = "wasm32"))]
+const MAX_POLLS: u32 = 1_830;
+/// Network errors in a row before the poll gives up and says so.
+#[cfg(not(target_arch = "wasm32"))]
+const POLL_MISSES: u8 = 3;
+
+/// The snapshot's page: what the service stores and compares.
+#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize)]
+pub struct SnapPage {
+    pub id: u64,
+    pub name: String,
+}
+
+/// The snapshot's node: the card as the map shows it.
+#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize)]
+pub struct SnapNode {
+    pub id: u64,
+    pub name: String,
+    pub parent: Option<u64>,
+    pub page: u64,
+    pub kind: String,
+    pub text: String,
+}
+
+/// The map as it is now: pages and every card below them, depth first.
+#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize)]
+pub struct Snapshot {
+    pub pages: Vec<SnapPage>,
+    pub nodes: Vec<SnapNode>,
+}
+
+impl Snapshot {
+    /// Walk `doc.pages`, then each page's children, capping at the service's limits.
+    ///
+    /// The walk is iterative and remembers visited nodes, so a malformed document with a cycle
+    /// cannot loop or overflow the stack. Pages and cards beyond the caps are left out (the
+    /// service rejects larger snapshots outright).
+    pub fn of(doc: &Document) -> Snapshot {
+        let mut pages = Vec::new();
+        let mut nodes = Vec::new();
+        // The map's cards are its top-level frames. Nested frames are the card's internal layout,
+        // and text layers are its body: both travel as the card's text, so the diff talks about
+        // cards the human named, not every text layer in the document.
+        for page_id in &doc.pages {
+            if pages.len() >= MAX_PAGES || nodes.len() >= MAX_NODES {
+                break;
+            }
+            let Some(page) = doc.node(*page_id) else { continue };
+            pages.push(SnapPage { id: page_id.0, name: page.name.clone() });
+            for child in &page.children {
+                if nodes.len() >= MAX_NODES {
+                    break;
+                }
+                let Some(node) = doc.node(*child) else { continue };
+                if !is_card(&node.kind) {
+                    continue;
+                }
+                nodes.push(SnapNode {
+                    id: child.0,
+                    name: node.name.clone(),
+                    parent: None,
+                    page: page_id.0,
+                    kind: kind_name(&node.kind).to_string(),
+                    text: card_text(doc, *child),
+                });
+            }
+        }
+        Snapshot { pages, nodes }
+    }
+    /// Whether anything would differ between the two snapshots.
+    pub fn differs(&self, other: &Snapshot) -> bool {
+        self != other
+    }
+}
+
+fn is_card(kind: &NodeKind) -> bool {
+    matches!(
+        kind,
+        NodeKind::Frame
+            | NodeKind::Group
+            | NodeKind::Section { .. }
+            | NodeKind::Component { .. }
+            | NodeKind::ComponentSet { .. }
+            | NodeKind::Instance { .. }
+    )
+}
+
+/// Every text layer below `root`, joined; the card's body for the diff.
+fn card_text(doc: &Document, root: NodeId) -> String {
+    let mut out = String::new();
+    let mut stack = vec![root];
+    let mut seen = HashSet::new();
+    while let Some(id) = stack.pop() {
+        if !seen.insert(id) {
+            continue;
+        }
+        let Some(node) = doc.node(id) else { continue };
+        if let NodeKind::Text(text) = &node.kind {
+            let part = text.characters.trim();
+            if !part.is_empty() {
+                if !out.is_empty() {
+                    out.push('\n');
+                }
+                out.push_str(part);
+                if out.len() >= 4_000 {
+                    out.truncate(4_000);
+                    break;
+                }
+            }
+        }
+        for child in node.children.iter().rev() {
+            stack.push(*child);
+        }
+    }
+    out
+}
+
+/// The short kind name the service's snapshot stores.
+fn kind_name(kind: &NodeKind) -> &'static str {
+    match kind {
+        NodeKind::Frame => "frame",
+        NodeKind::Text(_) => "text",
+        NodeKind::Group => "group",
+        NodeKind::Rectangle => "rectangle",
+        NodeKind::Ellipse { .. } => "ellipse",
+        NodeKind::Vector { .. } => "vector",
+        NodeKind::Component { .. } | NodeKind::ComponentSet { .. } => "component",
+        NodeKind::Instance { .. } => "instance",
+        _ => "other",
+    }
+}
+
+/// The last successful sync, as the service reports it.
+#[derive(Clone, Debug, Default, Deserialize)]
+pub struct Last {
+    #[serde(default)]
+    pub exists: bool,
+    #[serde(default)]
+    pub commit: String,
+    #[serde(default)]
+    pub at: String,
+}
+
+/// Deserialize `last` as `None` when the service says it does not exist.
+fn last_or_none<'de, D>(deserializer: D) -> Result<Option<Last>, D::Error>
+where
+    D: serde::Deserializer<'de>,
+{
+    let last = Option::<Last>::deserialize(deserializer)?;
+    Ok(last.and_then(|last| last.exists.then_some(last)))
+}
+
+/// One added or removed card in the design diff.
+#[derive(Clone, Debug, Default, Deserialize)]
+pub struct MapCard {
+    #[serde(default)]
+    pub id: u64,
+    #[serde(default)]
+    pub name: String,
+    #[serde(default)]
+    pub page: String,
+}
+
+/// One changed card in the design diff.
+#[derive(Clone, Debug, Default, Deserialize)]
+pub struct MapChange {
+    #[serde(default)]
+    pub id: u64,
+    #[serde(default)]
+    pub name: String,
+    #[serde(default)]
+    pub fields: Vec<String>,
+}
+
+/// The design half of the diff.
+#[derive(Clone, Debug, Default, Deserialize)]
+pub struct MapDiff {
+    #[serde(default)]
+    pub added: Vec<MapCard>,
+    #[serde(default)]
+    pub removed: Vec<MapCard>,
+    #[serde(default)]
+    pub changed: Vec<MapChange>,
+}
+
+impl MapDiff {
+    /// The changes the widget counts and the button badges.
+    pub fn total(&self) -> usize {
+        self.added.len().saturating_add(self.removed.len()).saturating_add(self.changed.len())
+    }
+}
+
+/// One changed file in the code diff.
+#[derive(Clone, Debug, Default, Deserialize)]
+pub struct FileDelta {
+    #[serde(default)]
+    pub path: String,
+    #[serde(default)]
+    pub added: u64,
+    #[serde(default)]
+    pub removed: u64,
+}
+
+/// One commit in the code diff.
+#[derive(Clone, Debug, Default, Deserialize)]
+pub struct CommitInfo {
+    #[serde(default)]
+    pub hash: String,
+    #[serde(default)]
+    pub subject: String,
+}
+
+/// The code half of the diff.
+#[derive(Clone, Debug, Default, Deserialize)]
+pub struct CodeDiff {
+    #[serde(default)]
+    pub head: Option<String>,
+    #[serde(default)]
+    pub from: Option<String>,
+    #[serde(default)]
+    pub files: Vec<FileDelta>,
+    #[serde(default)]
+    pub commits: Vec<CommitInfo>,
+    #[serde(default)]
+    pub note: Option<String>,
+}
+
+/// The service's answer to `diff`.
+#[derive(Debug, Default, Deserialize)]
+pub struct DiffReply {
+    #[serde(default)]
+    pub ok: bool,
+    #[serde(default)]
+    pub error: Option<String>,
+    #[serde(default, deserialize_with = "last_or_none")]
+    pub last: Option<Last>,
+    #[serde(default)]
+    pub map: MapDiff,
+    #[serde(default)]
+    pub code: CodeDiff,
+}
+
+impl DiffReply {
+    /// Whether a sync would have anything to apply or say.
+    fn has_work(&self) -> bool {
+        self.map.total() > 0 || !self.code.files.is_empty() || !self.code.commits.is_empty()
+    }
+}
+
+/// One sync job the service reports.
+#[derive(Clone, Debug, Default, Deserialize)]
+pub struct Job {
+    #[serde(default)]
+    pub id: String,
+    /// `in_flight`, `done` or `failed`.
+    #[serde(default)]
+    pub state: String,
+    #[serde(default)]
+    pub started: String,
+    #[serde(default)]
+    pub agent: Option<Value>,
+    #[serde(default)]
+    pub reason: Option<String>,
+}
+
+impl Job {
+    fn in_flight(&self) -> bool {
+        self.state.trim().eq_ignore_ascii_case("in_flight")
+    }
+
+    fn failed(&self) -> bool {
+        self.state.trim().eq_ignore_ascii_case("failed")
+    }
+
+    /// The agent kind the flight names: the service's, then the outcome's name.
+    fn kind(&self) -> Option<String> {
+        let agent = self.agent.as_ref()?;
+        ["kind", "name"]
+            .into_iter()
+            .filter_map(|key| agent.get(key).and_then(Value::as_str))
+            .map(str::trim)
+            .find(|value| !value.is_empty())
+            .map(str::to_string)
+    }
+}
+
+/// The service's answer to `sync`.
+#[derive(Debug, Default, Deserialize)]
+pub struct SyncReply {
+    #[serde(default)]
+    pub ok: bool,
+    #[serde(default)]
+    pub error: Option<String>,
+    #[serde(default)]
+    pub job: Option<Job>,
+    #[serde(default)]
+    pub agent: Option<Value>,
+}
+
+/// The service's answer to `sync_status`.
+#[derive(Debug, Default, Deserialize)]
+pub struct StatusReply {
+    #[serde(default)]
+    pub ok: bool,
+    #[serde(default)]
+    pub error: Option<String>,
+    #[serde(default)]
+    pub job: Option<Job>,
+    #[serde(default, deserialize_with = "last_or_none")]
+    pub last: Option<Last>,
+}
+
+/// What a job thread sends back.
+pub enum JobMsg {
+    /// The `sync` request returned (or failed before it did).
+    Started(Result<SyncReply, String>),
+    /// One `sync_status` poll returned.
+    Status(Result<StatusReply, String>),
+}
+
+/// The Sync button and widget's state.
+#[derive(Default)]
+pub struct State {
+    /// The widget is showing.
+    pub open: bool,
+    /// A diff or a sync request is on its thread (status polls are not "busy").
+    pub busy: bool,
+    /// The diff last read; replaced after a successful sync.
+    pub diff: Option<DiffReply>,
+    /// The last sync the service reported (also inside `diff`, kept while a refresh runs).
+    pub last: Option<Last>,
+    /// Why the last request failed, shown in the widget.
+    pub error: Option<String>,
+    /// The optional note sent with the next sync.
+    pub note: String,
+    /// The current or last sync job.
+    pub job: Option<Job>,
+    /// The diff thread's answer.
+    pub rx: Option<Receiver<Result<DiffReply, String>>>,
+    /// The sync-start thread and the status poll thread's messages.
+    pub job_rx: Option<Receiver<JobMsg>>,
+    /// The map changed after the diff was read.
+    pub dirty: bool,
+    /// The snapshot the current diff was taken from.
+    snapshot: Option<Snapshot>,
+    /// The workspace this state belongs to.
+    workspace: Option<String>,
+    /// The document uid the diff belongs to.
+    doc: Option<u64>,
+    /// The design changes the current job was started with.
+    applied: usize,
+    /// A diff refresh is due after the job finished.
+    refresh: bool,
+    /// The sync request is on its thread; the job has not come back yet.
+    starting: bool,
+    /// The target menu is open.
+    menu_open: bool,
+}
+
+impl State {
+    /// Whether a job is in flight (the button says `Syncing…`).
+    fn in_flight(&self) -> bool {
+        self.job.as_ref().is_some_and(Job::in_flight)
+    }
+
+    /// Whether the action button must stay disabled.
+    fn locked(&self) -> bool {
+        self.busy || self.starting || self.in_flight()
+    }
+
+    /// The design changes the button badges, when a diff is loaded.
+    fn changes(&self) -> Option<usize> {
+        self.diff.as_ref().map(|diff| diff.map.total())
+    }
+
+    /// Whether a sync has something to do: a design or code change, or a note.
+    fn has_work(&self) -> bool {
+        !self.note.trim().is_empty() || self.diff.as_ref().is_some_and(DiffReply::has_work)
+    }
+
+    /// Forget everything about the previous workspace or document, keeping nothing in flight.
+    fn reset(&mut self) {
+        *self = State::default();
+    }
+}
+
+/// The Sync action belongs to the map header: one compact button, no floating pill.
+pub fn header_button(app: &mut FigApp, ui: &mut egui::Ui, ctx: &egui::Context) {
+    let in_flight = app.sync.in_flight();
+    let starting = app.sync.starting;
+    let label = if in_flight || starting {
+        "Syncing…".to_string()
+    } else {
+        match app.sync.changes() {
+            Some(changes) => format!("Sync {changes}"),
+            None => "Sync".to_string(),
+        }
+    };
+    let color = if in_flight || starting { ACCENT } else { INK };
+    let stroke = if in_flight || starting { ACCENT } else { BORDER };
+    let enabled = app.active_workspace.is_some();
+    let button = egui::Button::new(egui::RichText::new(label).size(10.5).color(color))
+        .fill(PANEL)
+        .stroke(Stroke::new(1.0, stroke))
+        .corner_radius(CornerRadius::same(8))
+        .min_size(vec2(78.0, 28.0));
+    let response = ui.add_enabled(enabled, button);
+    a11y::button(&response, "Sync the map with the workspace");
+    let response = response.on_hover_text("Sync the map with the workspace");
+    if response.clicked() {
+        open_panel(app, ctx);
+    }
+}
+
+/// Open the widget and read a fresh diff from the current map.
+pub fn open_panel(app: &mut FigApp, ctx: &egui::Context) {
+    app.sync.open = true;
+    app.sync.menu_open = false;
+    if app.sync.busy {
+        return;
+    }
+    let Some(workspace) = app.active_workspace.clone() else {
+        app.toast("Open a workspace map to sync.");
+        return;
+    };
+    match snapshot_now(app) {
+        Ok(snapshot) => start_diff(app, ctx, snapshot, workspace),
+        Err(message) => {
+            app.sync.open = false;
+            app.toast(message);
+        }
+    }
+}
+
+/// Draw the Sync widget (the header button opens it).
+pub fn show(app: &mut FigApp, ctx: &egui::Context) {
+    let Some(workspace) = app.active_workspace.clone() else {
+        if app.sync.workspace.is_some() {
+            app.sync.reset();
+        }
+        return;
+    };
+    if app.sync.workspace.as_deref() != Some(workspace.as_str()) {
+        app.sync.reset();
+        app.sync.workspace = Some(workspace.clone());
+    }
+    let uid = app.session.ds().ok().map(|ds| ds.uid);
+    if app.sync.doc != uid {
+        // A different document: its diff is not this map's. A job already in flight belongs to
+        // the workspace and keeps polling; only the diff is dropped.
+        app.sync.doc = uid;
+        app.sync.diff = None;
+        app.sync.snapshot = None;
+        app.sync.dirty = false;
+        app.sync.error = None;
+        app.sync.open = false;
+        app.sync.menu_open = false;
+    }
+
+    poll_diff(app);
+    poll_job(app, ctx);
+    if app.sync.refresh && !app.sync.busy {
+        app.sync.refresh = false;
+        if let Ok(snapshot) = snapshot_now(app) {
+            start_diff(app, ctx, snapshot, workspace.clone());
+        }
+    }
+    if app.sync.open {
+        refresh_dirty(app);
+    } else {
+        app.sync.dirty = false;
+    }
+
+    if !app.sync.open {
+        return;
+    }
+
+    let menu_was_open = app.sync.menu_open;
+    let mut out = WidgetOut::default();
+    // The anchored area takes its first frame's size from `default_size`; without it the
+    // scroll area inherits egui's 400-point default and the widget stops halfway down.
+    let max_h = (ctx.content_rect().height() - 140.0).max(220.0);
+    // The flight (or failure) card stays above the scroll area so it is visible even when the
+    // human had scrolled to the agent and note.
+    let job_card = app.sync.job.as_ref().is_some_and(|job| job.in_flight() || job.failed());
+    // A fixed, bounded viewport: an anchored Area that grows with its scrollable content would
+    // chase its own height, and shrinking to measured content lets egui's clipping hide the rest.
+    let widget_h = max_h.min(620.0);
+    let scroll_h = (widget_h - 96.0 - if job_card { 86.0 } else { 0.0 }).max(140.0);
+    let area = egui::Area::new(Id::new("sync_widget"))
+        .anchor(Align2::RIGHT_TOP, vec2(-EDGE, EDGE + BUTTON_H + 10.0))
+        .default_size(vec2(WIDGET_W, widget_h))
+        .order(egui::Order::Foreground)
+        .show(ctx, |ui| {
+            egui::Frame::NONE
+                .fill(PANEL)
+                .stroke(Stroke::new(1.0, BORDER))
+                .corner_radius(CornerRadius::same(10))
+                .shadow(egui::epaint::Shadow { offset: [0, 8], blur: 24, spread: 0, color: Color32::from_black_alpha(36) })
+                .inner_margin(egui::Margin::symmetric(18, 16))
+                .show(ui, |ui| {
+                    ui.set_width(WIDGET_W - 2.0 * PAD);
+                    out = widget_body(ui, &mut app.sync, &mut app.compose, scroll_h);
+                });
+        });
+
+    let escape = ctx.input(|input| input.key_pressed(Key::Escape));
+    if escape {
+        if menu_was_open {
+            app.sync.menu_open = false;
+        } else {
+            app.sync.open = false;
+        }
+    }
+    let pressed = ctx.input(|input| input.pointer.any_pressed());
+    let pointer = ctx.input(|input| input.pointer.interact_pos());
+    let inside = pointer.is_some_and(|pos| area.response.rect.contains(pos));
+    if pressed && !inside && !menu_was_open {
+        // Clicking a target in the menu is outside the widget; the popup owns that click.
+        app.sync.open = false;
+        app.sync.menu_open = false;
+    }
+    if out.close {
+        app.sync.open = false;
+        app.sync.menu_open = false;
+    }
+    if out.sync && app.sync.open {
+        match snapshot_now(app) {
+            Ok(snapshot) => start_sync(app, ctx, workspace, snapshot),
+            Err(message) => app.toast(message),
+        }
+    }
+}
+
+/// What the widget body asked for.
+#[derive(Default)]
+struct WidgetOut {
+    close: bool,
+    sync: bool,
+}
+
+/// The widget's frame contents: header, last sync, the diffs, agent, note and action.
+fn widget_body(ui: &mut Ui, state: &mut State, compose: &mut crate::compose::State, scroll_h: f32) -> WidgetOut {
+    let mut out = WidgetOut::default();
+
+    ui.horizontal(|ui| {
+        ui.spacing_mut().item_spacing = vec2(8.0, 0.0);
+        ui.label(egui::RichText::new("SYNC").font(mono(9.5)).color(ACCENT));
+        ui.label(egui::RichText::new("main ↔ map").font(mono(9.0)).color(MUTED));
+        ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+            if close_button(ui) {
+                out.close = true;
+            }
+        });
+    });
+    ui.add_space(7.0);
+    let last_line = match &state.last {
+        Some(last) => last_line(last),
+        None => "first sync".to_string(),
+    };
+    ui.label(egui::RichText::new(last_line).font(mono(9.5)).color(MUTED));
+    if state.dirty {
+        ui.label(egui::RichText::new("the map changed since this diff").font(mono(8.5)).color(ACCENT));
+    }
+    if let Some(job) = state.job.as_ref() {
+        if job.in_flight() {
+            ui.add_space(10.0);
+            flight_card(ui, job, compose);
+        } else if job.failed() {
+            let reason = job.reason.clone().unwrap_or_else(|| "The sync failed.".to_string());
+            ui.add_space(10.0);
+            failed_card(ui, &reason);
+        }
+    }
+    ui.add_space(10.0);
+    divider(ui);
+    ui.add_space(10.0);
+
+    egui::ScrollArea::vertical()
+        .id_salt("sync_widget_body")
+        .max_height(scroll_h)
+        .auto_shrink([false, false])
+        .show(ui, |ui| {
+            ui.set_width(ui.available_width());
+            if let Some(error) = state.error.clone() {
+                error_block(ui, &error);
+                ui.add_space(10.0);
+            }
+
+            match state.diff.as_ref() {
+                Some(diff) => {
+                    design_section(ui, &diff.map);
+                    ui.add_space(14.0);
+                    code_section(ui, state.last.as_ref(), &diff.code);
+                }
+                None => {
+                    ui.add_space(5.0);
+                    ui.horizontal(|ui| {
+                        ui.spacing_mut().item_spacing = vec2(7.0, 0.0);
+                        if state.busy {
+                            ui.add(egui::Spinner::new().size(11.0).color(ACCENT));
+                            ui.label(egui::RichText::new("Reading the diff…").font(regular(11.0)).color(MUTED));
+                        } else {
+                            ui.label(egui::RichText::new("No diff read yet.").font(regular(11.0)).color(MUTED));
+                        }
+                    });
+                }
+            }
+
+            ui.add_space(16.0);
+            divider(ui);
+            ui.add_space(14.0);
+            eyebrow(ui, "AGENT", MUTED);
+            ui.add_space(6.0);
+            let picked = target_chip(ui, &compose.targets, compose.target.as_ref(), &mut state.menu_open);
+            if picked.is_some() {
+                compose.target = picked;
+            }
+
+            ui.add_space(14.0);
+            eyebrow(ui, "NOTE FOR THIS SYNC", MUTED);
+            ui.add_space(5.0);
+            note_field(ui, &mut state.note);
+
+            ui.add_space(12.0);
+            let syncing = state.starting || state.in_flight();
+            let locked = state.locked();
+            let target = compose.target.as_ref();
+            let ready = state.diff.as_ref().is_some_and(|diff| diff.ok);
+            let enabled = !locked && target.is_some() && ready && state.has_work();
+            let label = if syncing {
+                "Syncing…".to_string()
+            } else {
+                match target {
+                    Some(target) => format!("Sync with {}", kind_label(target.kind())),
+                    None => "Sync".to_string(),
+                }
+            };
+            if action_button(ui, &label, enabled, syncing) {
+                out.sync = true;
+            }
+            ui.add_space(6.0);
+            let hint = if target.is_none() {
+                if compose.targets.is_empty() { "No agent is available in this workspace yet." } else { "Choose an agent to sync." }
+            } else if syncing {
+                "The map stays editable while the sync runs."
+            } else if state.busy {
+                "Reading the diff…"
+            } else if !ready {
+                "Refresh the diff to sync."
+            } else if !state.has_work() {
+                "Change the map or add a note to sync."
+            } else {
+                "The map stays editable."
+            };
+            ui.label(egui::RichText::new(hint).font(mono(8.5)).color(MUTED));
+        });
+    out
+}
+
+/// The header's ×.
+fn close_button(ui: &mut Ui) -> bool {
+    let (rect, response) = ui.allocate_exact_size(vec2(20.0, 20.0), Sense::click());
+    let response = response.on_hover_cursor(egui::CursorIcon::PointingHand);
+    a11y::button(&response, "Close sync");
+    let hot = response.hovered();
+    if hot {
+        ui.painter().circle_filled(rect.center(), 9.0, SOFT);
+    }
+    ui.painter().text(rect.center(), Align2::CENTER_CENTER, "×", regular(13.0), if hot { ACCENT } else { MUTED });
+    response.clicked()
+}
+
+/// The in-flight card: spinner, `Sync in flight · kind`, and when it started.
+fn flight_card(ui: &mut Ui, job: &Job, compose: &crate::compose::State) {
+    let kind = job
+        .kind()
+        .or_else(|| compose.target.as_ref().map(|target| kind_label(target.kind()).to_string()))
+        .unwrap_or_else(|| "agent".to_string());
+    egui::Frame::NONE
+        .fill(SOFT)
+        .stroke(Stroke::new(1.0, ACCENT))
+        .corner_radius(CornerRadius::same(8))
+        .inner_margin(egui::Margin::symmetric(12, 10))
+        .show(ui, |ui| {
+            ui.set_width(ui.available_width());
+            ui.horizontal(|ui| {
+                ui.spacing_mut().item_spacing = vec2(8.0, 0.0);
+                ui.add(egui::Spinner::new().size(13.0).color(ACCENT));
+                ui.label(egui::RichText::new(format!("Sync in flight · {kind}")).font(semibold(11.0)).color(ACCENT));
+            });
+            ui.add_space(4.0);
+            let started = job.started.trim();
+            let line = if started.is_empty() { "started just now".to_string() } else { format!("started {started}") };
+            ui.label(egui::RichText::new(line).font(mono(9.0)).color(MUTED));
+            ui.add_space(3.0);
+            ui.label(egui::RichText::new("The map stays editable.").font(mono(8.5)).color(FAINT));
+        });
+}
+
+/// A failed job's reason, kept in the widget so the next sync can be set up.
