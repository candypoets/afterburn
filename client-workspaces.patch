diff -ruN --exclude target .client-src-orig/crates/ui-egui/src/agents.rs client-src/crates/ui-egui/src/agents.rs
--- .client-src-orig/crates/ui-egui/src/agents.rs	1970-01-01 01:00:00.000000000 +0100
