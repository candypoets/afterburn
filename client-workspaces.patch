+#[cfg(not(target_arch = "wasm32"))]
+pub(crate) fn send_request(address: &str, request: &str) -> Result<SendReply, String> {
+    let line = ask(address, request, SEND_TIMEOUT)?;
+    serde_json::from_str(&line).map_err(|e| format!("The project service sent a reply this app can't read: {e}"))
+}
+
+/// Ask the project service one newline-terminated JSON request and return its reply line.
+#[cfg(not(target_arch = "wasm32"))]
+fn ask(address: &str, request: &str, timeout: Duration) -> Result<String, String> {
+    let addresses = address.to_socket_addrs().map_err(|e| format!("Can't resolve the project service at {address}: {e}"))?;
+    let mut last = format!("no address for {address}");
+    let mut stream = None;
+    for address in addresses {
+        match TcpStream::connect_timeout(&address, CONNECT_TIMEOUT) {
+            Ok(connected) => {
+                stream = Some(connected);
+                break;
+            }
+            Err(e) => last = e.to_string(),
+        }
+    }
+    let mut stream = stream.ok_or_else(|| format!("Can't reach the project service at {address}: {last}"))?;
+    stream.set_read_timeout(Some(timeout)).map_err(|e| format!("Can't set the project service timeout: {e}"))?;
+    stream.set_write_timeout(Some(timeout)).map_err(|e| format!("Can't set the project service timeout: {e}"))?;
+    stream.set_nodelay(true).ok();
+    stream
+        .write_all(request.as_bytes())
+        .and_then(|_| stream.write_all(b"\n"))
+        .map_err(|e| format!("Can't ask the project service at {address}: {e}"))?;
+    let mut reader = BufReader::new(stream);
+    let mut line = String::new();
+    let read = reader
+        .by_ref()
+        .take(MAX_REPLY as u64 + 1)
+        .read_line(&mut line)
+        .map_err(|e| format!("No answer from the project service at {address}: {e}"))?;
+    if read == 0 {
+        return Err(format!("The project service at {address} closed without an answer."));
+    }
+    if line.len() > MAX_REPLY {
+        return Err(format!("The project service at {address} sent too large an answer."));
+    }
+    Ok(line.trim().to_string())
+}
