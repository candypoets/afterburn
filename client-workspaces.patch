+        .inner_margin(egui::Margin::symmetric(12, 10))
+        .show(ui, |ui| {
+            ui.set_width(ui.available_width());
+            ui.label(egui::RichText::new("Sync failed").font(semibold(11.0)).color(DANGER));
+            ui.add_space(3.0);
