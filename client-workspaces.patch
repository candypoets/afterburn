+/// The agent's `kind` (or `name`) from the service's reply.
+fn agent_kind(agent: &Value) -> Option<String> {
+    ["kind", "name"]
+        .into_iter()
+        .filter_map(|key| agent.get(key).and_then(Value::as_str))
+        .map(str::trim)
+        .find(|value| !value.is_empty())
+        .map(str::to_string)
+}
