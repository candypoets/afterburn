[Unit]
Description=Mindmap node (worktree designs and shared Herdr)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/code/mindmap
Environment=HOME=/root
Environment=HERDR_ENV=1
Environment=HERDR_SOCKET_PATH=/root/.config/herdr/herdr.sock
Environment=PATH=/root/.local/bin:/root/.volta/bin:/root/.kimi-code/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/root/code/mindmap/service/target/release/mindmap-node serve --bind 127.0.0.1:47822
Restart=on-failure
RestartSec=2
# Herdr is a shared daemon. Stopping this node must never terminate its agents.
KillMode=process

[Install]
WantedBy=multi-user.target
